# The deployed API, e.g. https://poca-pizzeria-server.vercel.app
# No trailing slash. NEXT_PUBLIC_* values are baked in at build time —
# change one and you must rebuild.
NEXT_PUBLIC_API_URL=http://localhost:1000

# Cloudinary unsigned upload, used by the admin dish and category forms
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
